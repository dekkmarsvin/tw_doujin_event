{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tw-catalog",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-05-22",
  // Identity and circle-authored overrides only. The reader's catalog and map
  // stay static assets; no advanced-mode `main` entry, so `/`, `/assets/*` and
  // `/fonts/*` are still served straight from the edge.
  //
  // One binding, named `DB`, because that is what the Functions read. Leaving
  // the binding `wrangler d1 create` generates from the database name would
  // give the same database two names and hide which one the code uses.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tw-catalog-identity",
      "database_id": "935b605f-6d08-436f-bbf8-f80b8f3bd7e2"
    }
  ],
  // The Turnstile sitekey the sign-in form renders, handed to the browser by
  // `GET /api/auth/config`. Public by definition, so it belongs in version
  // control rather than in dashboard state: a deployment made with this config
  // file overwrites dashboard variables unless `keep_vars` is set, so a value
  // that lives only there can vanish on an unrelated deploy. Its secret half is
  // a Pages secret and never appears in this file.
  //
  // Top level is production only — `vars` is non-inheritable, which is why the
  // preview environment declares its own dummy pair below.
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAET9rAWIzjOckkSc"
  },
  // Preview (every branch that is not the production branch) gets its own
  // database. Without this the top-level binding applies to preview too, so a
  // claim submitted while testing a pull request would take the real circle's
  // one owner slot, and saving an edit would rewrite the overrides document
  // that production readers download.
  //
  // `d1_databases` is not inherited: an environment either declares the whole
  // binding or has none at all. Anything added at the top level later — KV, R2,
  // another database — has to be repeated here or preview simply loses it.
  //
  // The binding stays `DB`. `wrangler d1 create` suggests one named after the
  // database, but the Functions read `env.DB`; a per-environment binding name
  // would leave preview with no database under the name the code looks for.
  "env": {
    "preview": {
      // Preview has two mailboxes and picks between them by recipient. The
      // .test addresses below are captured in the preview D1 for E2E and never
      // leave Cloudflare. A person testing by hand uses an address on
      // PREVIEW_SANDBOX_RECIPIENTS instead, delivered through the Mailgun
      // sandbox domain bound to this environment. Picking by recipient rather
      // than by branch is not a preference: Pages knows only `production` and
      // `preview`, so anything set here applies to every preview deployment,
      // and CI needs the sink on the same ones a human needs an inbox on.
      //
      // That list is a Pages preview secret rather than a variable here — it
      // holds real personal addresses and this repository is public. So are
      // the sandbox MAILGUN_* pair and PREVIEW_E2E_TOKEN, all intentionally
      // absent from this file.
      //
      // Turnstile runs on Cloudflare's documented dummy keys here. The E2E
      // driver is not a browser and cannot solve a real widget, and preview is
      // the only environment the circle portal is exercised in, so the pair has
      // to be the always-passes one — visible widget `1x…AA`, secret `1x…AA`.
      // The dummy secret accepts any token by design, which is exactly why it
      // must never reach production: there it is a real secret, set with
      // `wrangler pages secret put`.
      "vars": {
        "PREVIEW_MAIL_SINK": "d1",
        "PREVIEW_TEST_RECIPIENTS": "preview-admin@example.test,preview-circle@example.test",
        "TURNSTILE_SITEKEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tw-catalog-identity-preview",
          "database_id": "88716ee2-4d17-4c93-87aa-bfe9c961a599"
        }
      ]
    }
  }
}
