{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tw-catalog",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-05-22",
  // Identity and circle-authored overrides only. The reader's catalog and map
  // stay static assets; no advanced-mode `main` entry, so `/`, `/assets/*` and
  // `/fonts/*` are still served straight from the edge.
  //
  // One binding, named `DB`, because that is what the Functions read. Leaving
  // the binding `wrangler d1 create` generates from the database name would
  // give the same database two names and hide which one the code uses.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tw-catalog-identity",
      "database_id": "935b605f-6d08-436f-bbf8-f80b8f3bd7e2"
    }
  ]
}
