/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://media.kotoban.top https://media-preview.kotoban.top https://drive.google.com https://lh3.googleusercontent.com https://i.pximg.net https://pbs.twimg.com https://i.imgur.com; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Turnstile is the only third-party script the site loads, and it loads here
# only: the circle and organizer sign-in forms. Matching rules are combined rather
# than overridden, so the site-wide policy above has to be removed by name
# before this one can replace it — two Content-Security-Policy headers would be
# enforced as their intersection and block the widget.
#
# `/circle*` covers the entry (`/circle`) and its built document
# (`/circle.html`). `tests/circle-overrides.test.mjs` asserts this policy is the
# site-wide one plus exactly the two Turnstile sources, so a host added to
# either policy alone fails the gate rather than the browser.
/circle*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data: https://media.kotoban.top https://media-preview.kotoban.top https://drive.google.com https://lh3.googleusercontent.com https://i.pximg.net https://pbs.twimg.com https://i.imgur.com; manifest-src 'self'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests

/organizer*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data: https://media.kotoban.top https://media-preview.kotoban.top https://drive.google.com https://lh3.googleusercontent.com https://i.pximg.net https://pbs.twimg.com https://i.imgur.com; manifest-src 'self'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/events/*
  Cache-Control: public, max-age=300, must-revalidate

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
