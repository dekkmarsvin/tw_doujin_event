# Cloudflare Web Analytics is injected by the edge, not by this repository: the
# zone setting adds a `<script type="module" crossorigin integrity=... >` tag to
# every HTML response, so `script-src` has to admit it or the browser blocks the
# beacon and the console fills with CSP errors.
#
# The source is the bare origin, not the `https://static.cloudflareinsights.com/beacon.min.js`
# that the Cloudflare FAQ prints. That path-scoped value is written for the
# manually embedded snippet. Automatic injection loads a *versioned* path —
# `/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495` — and a CSP
# source expression whose path does not end in `/` matches that exact path only,
# so the documented value would still block the injected tag. The version string
# rotates, so pinning any path is a policy that silently breaks on Cloudflare's
# next beacon release.
#
# No `connect-src` change is needed. Automatic injection reports to this domain's
# own `/cdn-cgi/rum`, which `connect-src 'self'` already covers; only the manual
# snippet talks to `cloudflareinsights.com`. If the beacon is ever embedded by
# hand, that host has to be added there too.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; manifest-src 'self'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Turnstile is the only third-party script *this rule* adds, and it loads here
# only: the circle and organizer sign-in forms. Matching rules are combined rather
# than overridden, so the site-wide policy above has to be removed by name
# before this one can replace it — two Content-Security-Policy headers would be
# enforced as their intersection and block the widget.
#
# `/circle*` covers the entry (`/circle`) and its built document
# (`/circle.html`). `tests/circle-overrides.test.mjs` asserts this policy is the
# site-wide one plus exactly the two Turnstile sources, so a host added to
# either policy alone fails the gate rather than the browser.
/circle*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data: https:; manifest-src 'self'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests

/organizer*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data: https:; manifest-src 'self'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/events/*
  Cache-Control: public, max-age=300, must-revalidate

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
