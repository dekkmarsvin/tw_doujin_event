# Deterministic, local-only values for `npm run dev:portal`.
# These are not credentials and must never be copied to production.
EVENT_ID=sample
SESSION_SECRET=local-test-session-secret-not-for-production
HASH_PEPPER=local-test-hash-pepper-not-for-production
ADMIN_EMAILS=local-admin@example.test
PREVIEW_MAIL_SINK=d1
PREVIEW_TEST_RECIPIENTS=local-admin@example.test,local-circle@example.test
PREVIEW_E2E_TOKEN=local-test-preview-mail-token
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
THUMBNAIL_PUBLIC_ORIGIN=http://127.0.0.1:8788/__local-thumbnail
ORGANIZER_PUBLICATION_MODE=disabled
