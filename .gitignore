# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local Cloudflare secrets. `wrangler pages dev` reads these; `.env*` above does
# not cover the filename, so an API key would otherwise be committable.
.dev.vars
.dev.vars.*

# Local editor/agent tooling configuration, not project configuration.
/.claude/

# vercel
.vercel

/dist/
/.wrangler/
/.event-data/
/outputs/
/work/

# TypeScript incremental build cache
*.tsbuildinfo

# Local design exploration outputs; keep the maintained design system JSON.
/.impeccable/critique/
/.impeccable/mocks/
/.impeccable/surfaces/
