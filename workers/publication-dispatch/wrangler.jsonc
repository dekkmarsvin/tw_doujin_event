{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tw-catalog-publication-dispatch",
  "main": "./index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  // Keep environment-specific recipient lists managed in the Dashboard out of
  // this public repository. Explicit vars below still take precedence.
  "keep_vars": true,
  // Workers Logs 與 Workers Traces 都開著，兩者各自宣告 `enabled`：頂層的
  // `observability.enabled` 目前只開 logs，tracing 仍在 beta，不會被它帶開。
  // 這個 Worker 每分鐘跑一次、沒有 HTTP 入口，唯一能看到它行為的地方就是這裡，
  // 所以 `head_sampling_rate` 取 1（全量）——1440 次/日的量級不需要抽樣。
  // `invocation_logs` 保留 Cloudflare 自動寫的那一行 invocation 摘要，沒有它就
  // 只剩程式自己 `console.*` 的內容，看不出這一次 tick 是否真的被觸發。
  // `persist` 是預設值 true，寫出來是為了說明資料會留在 Cloudflare Dashboard 供
  // 查詢，而不是只轉送到外部 destination——本專案沒有設 destinations。本帳號是
  // Workers Paid，logs 保留 7 天、每月含 2,000 萬則事件；每分鐘一次的量級離
  // 上限很遠，所以不必為了額度調低取樣。
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Preview delivery verified; independent of publication mode.
    "ADMIN_REVIEW_NOTIFICATIONS_ENABLED": "true",
    "NOTIFICATION_ORIGIN": "https://map.kotoban.top",
    "MAILGUN_DOMAIN": "verify.kotoban.top",
    "MAILGUN_SENDER": "noreply@verify.kotoban.top",
    "ORGANIZER_PUBLICATION_MODE": "github",
    "GITHUB_APP_ID": "4931208",
    "GITHUB_APP_INSTALLATION_ID": "161391064"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tw-catalog-identity",
    "database_id": "935b605f-6d08-436f-bbf8-f80b8f3bd7e2"
  }],
  "env": {
    "preview": {
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ORGANIZER_PUBLICATION_MODE": "disabled",
        "PREVIEW_MAIL_SINK": "d1",
        "PREVIEW_TEST_RECIPIENTS": "preview-admin@example.test,preview-circle@example.test",
        "NOTIFICATION_ORIGIN": "https://review-notifications.tw-catalog.pages.dev",
        "ADMIN_REVIEW_NOTIFICATIONS_ENABLED": "true",
        "MAILGUN_DOMAIN": "verify.kotoban.top",
        "MAILGUN_SENDER": "postmaster@verify.kotoban.top"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "tw-catalog-identity-preview",
        "database_id": "88716ee2-4d17-4c93-87aa-bfe9c961a599"
      }]
    }
  }
}
